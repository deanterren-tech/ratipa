{
  "rules": {
    ".read": "auth != null",
    "vehicleFleet": {
      ".write": "auth != null"
    },
    "brands": {
      ".write": "auth != null"
    },
    "vehicleBrands": {
      ".write": "auth != null"
    },
    "trailerBrands": {
      ".write": "auth != null"
    },
    "baza": {
      ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'root_admin'",
      "$periodId": {
        "events": {
          ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'root_admin'"
        }
      }
    },
    "users": {
      "$uid": {
        ".read": "$uid === auth.uid || root.child('users').child(auth.uid).child('role').val() === 'root_admin'",
        ".write": "$uid === auth.uid || root.child('users').child(auth.uid).child('role').val() === 'root_admin'"
      }
    },
    "ratipa_notifications": {
      ".read": "auth != null",
      ".write": "root.child('users').child(auth.uid).child('role').val() === 'root_admin' || root.child('users').child(auth.uid).child('role').val() === 'admin'"
    },
    "broadcastNotifications": {
      ".read": "auth != null",
      ".write": "root.child('users').child(auth.uid).child('role').val() === 'root_admin' || root.child('users').child(auth.uid).child('role').val() === 'admin'"
    },
    "trips_dashboard": {
      ".read": "auth != null",
      ".write": "auth != null",
      ".indexOn": ["isArchived"]
    },
    "telemetry_config": {
      ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'root_admin' || root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('role').val() === 'manager')"
    },
    "telemetry_mapping": {
      ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'root_admin' || root.child('users').child(auth.uid).child('role').val() === 'admin')"
    },
    "telemetry_mapping_history": {
      ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'root_admin' || root.child('users').child(auth.uid).child('role').val() === 'admin')"
    },
    "telemetry_rf_entry": {
      ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'root_admin' || root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('role').val() === 'manager' || root.child('users').child(auth.uid).child('role').val() === 'dispatcher' || root.child('users').child(auth.uid).child('role').val() === 'mechanic')"
    },
    "telemetry_requests": {
      ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'root_admin' || root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('role').val() === 'manager' || root.child('users').child(auth.uid).child('role').val() === 'dispatcher')"
    },
    "telemetry_checks": {
      ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'root_admin' || root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('role').val() === 'manager')"
    },
    "telemetry_check_config": {
      ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'root_admin' || root.child('users').child(auth.uid).child('role').val() === 'admin')"
    },
    "tripTimeline": {
      ".read": "auth != null",
      "trips": {
        ".write": "auth != null"
      },
      "vehicleEvents": {
        ".write": "auth != null"
      },
      "planGuard": {
        ".write": "auth != null"
      },
      "planPerms": {
        ".write": "auth != null"
      },
      "planRequests": {
        ".write": "auth != null"
      },
      "tripMeta": {
        ".write": "auth != null"
      },
      "config": {
        ".write": "auth != null"
      },
      "tripStages": {
        ".read": "auth != null",
        ".write": "auth != null",
        "$tripId": {
          "$stageId": {
            "plannedDate": {
              ".validate": "(!data.exists() || data.val() === null || data.val() === '') || (newData.exists() && newData.val() === data.val()) || root.child('users_list').child(auth.uid).child('role').val() === 'root_admin' || root.child('users_list').child(auth.uid).child('role').val() === 'admin'"
            },
            "actualDate": {
              ".validate": "(!data.exists() || data.val() === null || data.val() === '') || (newData.exists() && newData.val() === data.val()) || root.child('users_list').child(auth.uid).child('role').val() === 'root_admin' || root.child('users_list').child(auth.uid).child('role').val() === 'admin'"
            }
          }
        }
      }
    },
    "stageTemplates": {
      ".read": "auth != null",
      "$templateId": {
        ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'root_admin' || root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users_list').child(auth.uid).child('role').val() === 'root_admin' || root.child('users_list').child(auth.uid).child('role').val() === 'admin')"
      }
    }
  }
}
